# Copy to backend/.env (or export in your shell / hosting dashboard). Never commit real keys.

# ---- Optional AI semantic review --------------------------------------------
# none | openai | anthropic   ("openai" = any OpenAI-compatible API: OpenAI, Groq,
# OpenRouter, Together, or a local Ollama/LM Studio server via LLM_BASE_URL)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1 (Ollama; no key needed)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# ---- Optional source retrieval for flagged claims ---------------------------
# none | brave   (Brave Search API: https://api.search.brave.com)
SEARCH_PROVIDER=none
SEARCH_API_KEY=
MAX_CLAIMS_TO_VERIFY=5

# ---- Limits & security ------------------------------------------------------
MAX_CONTENT_CHARS=100000
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=3000000
# Keep false in production: blocks URL extraction from private/loopback addresses (SSRF guard)
ALLOW_PRIVATE_URLS=false
# Comma-separated origins allowed to call the API (only needed when the UI is hosted separately)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (build-time, only when the UI is hosted separately) -----------
# VITE_API_BASE_URL=https://your-api.example.com
